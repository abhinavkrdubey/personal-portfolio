---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";
const site = (await getEntry("pages", "site"))!.data;
const page = (await getEntry("pages", "experience"))!.data;
const experience = (await getCollection("experience")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={`Experience — ${site.shortName}`}>

  <section class="page-header">
    <span class="eyebrow">{page.eyebrow}</span>

    <h1>{page.title}</h1>

    <p>
      {page.intro}
    </p>
  </section>

  <section class="experience-page">

    {experience.map((item) => (
      <article>
        <span>{item.data.period}</span>
        <h2>{item.data.role}</h2>
        <h3>{item.data.company}</h3>
        <p>{item.data.summary}</p>
      </article>
    ))}

  </section>

</BaseLayout>
