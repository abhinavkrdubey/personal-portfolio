---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, getEntry, render } from "astro:content";
const site = (await getEntry("pages", "site"))!.data;
const page = (await getEntry("pages", "experience"))!.data;
const entries = (await getCollection("experience")).sort((a, b) => a.data.order - b.data.order);
const experience = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);
---

<BaseLayout title={`Experience — ${site.shortName}`}>

  <section class="page-header">
    <span class="eyebrow">{page.eyebrow}</span>

    <h1>{page.title}</h1>

    <p>
      {page.intro}
    </p>
  </section>

  <section class="experience-page">

    {experience.map(({ entry, Content }) => (
      <article>
        <span>{entry.data.period}</span>
        <h2>{entry.data.role}</h2>
        <h3>{entry.data.company} · {entry.data.location}</h3>
        <p>{entry.data.summary}</p>
        <div class="experience-details"><Content /></div>
      </article>
    ))}

  </section>

</BaseLayout>

<style>
  .experience-details { max-width: 760px; margin-top: 18px; }
  .experience-details :global(ul) { margin: 0; padding-left: 20px; }
  .experience-details :global(li) { margin: 8px 0; color: var(--muted); font-size: 13px; line-height: 1.7; }
</style>
