---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";

const projects = (await getCollection("projects", ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
const site = (await getEntry("pages", "site"))!.data;
const page = (await getEntry("pages", "home"))!.data;
const { metrics, skills, labServices } = page;
---

<BaseLayout
  title={`${site.name} — ${site.role}`}
  description={`${site.role} building machine learning, AI and production data systems.`}
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-copy">
      <span class="eyebrow">{page.eyebrow}</span>

      <h1>{site.name}</h1>

      <h2>
        {site.role} ·
        <span>{site.specialty}</span>
      </h2>

      <p>
        {page.intro}
      </p>

      <div class="hero-actions">
        <a class="button primary" href="/projects/">
          See Projects
          <span>→</span>
        </a>

        <a class="button secondary" href="/contact/">
          Get in Touch
          <span>↗</span>
        </a>
      </div>
    </div>

    <a class="hero-art" href="/homelab/" aria-label="View homelab">
      <div class="art-grid"></div>

      <div class="visual-card visual-left">
        <span class="visual-label">MODELS</span>

        <div class="donut"></div>

        <small>Experimentation</small>
      </div>

      <div class="visual-card visual-center">
        <span class="visual-label">ML SYSTEM</span>

        <div class="pipeline">
          <i></i>
          <i></i>
          <i></i>
          <i></i>
        </div>

        <div class="pipeline-labels">
          <span>Data</span>
          <span>Model</span>
          <span>API</span>
          <span>Monitor</span>
        </div>
      </div>

      <div class="visual-card visual-right">
        <span class="visual-label">IMPACT</span>

        <div class="bars">
          <i></i>
          <i></i>
          <i></i>
          <i></i>
          <i></i>
        </div>
      </div>

      <span class="floating-node node-1"></span>
      <span class="floating-node node-2"></span>
      <span class="floating-node node-3"></span>
      <span class="floating-node node-4"></span>
    </a>
  </section>


  <!-- METRICS -->
  <section class="metrics">
    {
      metrics.map((metric) => (
        <article>
          <strong>{metric.value}</strong>
          <h3>{metric.title}</h3>
          <p>{metric.text}</p>
        </article>
      ))
    }
  </section>


  <!-- PROJECTS -->
  <section class="home-section projects-section">
    <div class="section-heading">
      <div>
        <span class="eyebrow">{page.projectsLabel}</span>
        <h2>{page.projectsTitle}</h2>
      </div>

      <a href="/projects/">
        View all projects →
      </a>
    </div>

    <div class="project-grid">
      {
        projects.map((project, index) => (
          <a
            class="project-card"
            href={`/projects/${project.id}/`}
          >
            <div class="project-top">
              <span class="project-number">
                {String(index + 1).padStart(2, "0")}
              </span>

              <span class="project-arrow">
                ↗
              </span>
            </div>

            <div>
              <h3>{project.data.title}</h3>

              <p>{project.data.description}</p>

              <strong class="impact">
                {project.data.impact}
              </strong>

              <div class="tags">
                {
                  project.data.tags.map((tag) => (
                    <span>{tag}</span>
                  ))
                }
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>


  <!-- EXPERIENCE + STACK -->
  <section class="split-section">
    <a class="feature-panel experience-panel" href="/experience/">
      <div class="feature-top">
        <span class="eyebrow">{page.experienceLabel}</span>
        <span class="feature-arrow">↗</span>
      </div>

      <h2>{page.experienceTitle}</h2>

      <div class="experience-item">
        <span class="dot"></span>

        <div>
          <strong>{page.experienceRole}</strong>
          <h3>{page.experienceCompany}</h3>

          <p>
            {page.experienceText}
          </p>
        </div>
      </div>

      <span class="learn-more">
        View full experience →
      </span>
    </a>

    <a class="feature-panel stack-panel" href="/stack/">
      <div class="feature-top">
        <span class="eyebrow">{page.stackLabel}</span>
        <span class="feature-arrow">↗</span>
      </div>

      <h2>{page.stackTitle}</h2>

      <div class="skill-cloud">
        {
          skills.map((skill) => (
            <span>{skill}</span>
          ))
        }
      </div>

      <span class="learn-more">
        Explore technical stack →
      </span>
    </a>
  </section>


  <!-- HOMELAB -->
  <section class="home-section">
    <a class="homelab-card" href="/homelab/">
      <div class="homelab-copy">
        <span class="eyebrow">{page.homelabLabel}</span>

        <h2>
          {page.homelabTitle}
        </h2>

        <p>
          {page.homelabText}
        </p>

        <span class="learn-more">
          Explore the homelab →
        </span>
      </div>

      <div class="lab-diagram">
        <div class="service-grid">
          {
            labServices.map((service) => (
              <div class="service">
                <span class="status-dot"></span>
                {service}
              </div>
            ))
          }
        </div>

        <div class="connector"></div>

        <div class="docker-node">
          Docker
        </div>

        <div class="connector"></div>

        <div class="server-node">
          <strong>{page.serverTitle}</strong>
          <small>{page.serverText}</small>
        </div>
      </div>
    </a>
  </section>


  <!-- ABOUT -->
  <section class="about-strip">
    <div>
      <span class="eyebrow">{page.aboutLabel}</span>

      <h2>
        {page.aboutTitle}
      </h2>
    </div>

    <p>
      {page.aboutText}
    </p>

    <a href="/about/">
      More about how I work →
    </a>
  </section>


  <!-- CONTACT -->
  <section class="contact-cta">
    <div>
      <span class="eyebrow">{page.contactLabel}</span>

      <h2>
        {page.contactTitle}
      </h2>

      <p>
        {page.contactText}
      </p>
    </div>

    <a class="button primary" href="/contact/">
      Get in Touch
      <span>→</span>
    </a>
  </section>
</BaseLayout>


<style>
  .hero,
  .metrics,
  .home-section,
  .split-section,
  .about-strip,
  .contact-cta {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
  }


  /* HERO */

  .hero {
    min-height: 490px;

    padding: 72px 0 48px;

    display: grid;
    grid-template-columns: .92fr 1.08fr;
    align-items: center;

    gap: 60px;
  }


  .hero-copy {
    position: relative;
    z-index: 2;
  }


  .hero h1 {
    margin: 13px 0 0;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: clamp(70px, 8vw, 105px);

    line-height: .92;

    letter-spacing: -.06em;

    font-weight: 500;
  }


  .hero h2 {
    margin: 22px 0 0;

    font-size: 18px;
    font-weight: 700;

    letter-spacing: -.02em;
  }


  .hero h2 span {
    color: var(--blue);
  }


  .hero-copy > p {
    max-width: 560px;

    margin: 20px 0 0;

    color: var(--muted);

    font-size: 15px;

    line-height: 1.8;
  }


  .hero-actions {
    margin-top: 28px;

    display: flex;

    gap: 12px;
  }


  /* HERO ART */

  .hero-art {
    position: relative;

    min-height: 335px;

    display: block;

    perspective: 900px;
  }


  .art-grid {
    position: absolute;

    inset: 30px 0 0;

    background-image:
      linear-gradient(
        to right,
        rgba(49, 99, 181, .10) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        rgba(49, 99, 181, .10) 1px,
        transparent 1px
      );

    background-size: 38px 38px;

    mask-image:
      radial-gradient(
        circle at center,
        black,
        transparent 72%
      );

    transform:
      perspective(500px)
      rotateX(61deg);
  }


  .visual-card {
    position: absolute;

    border: 1px solid
      color-mix(in srgb, var(--blue) 22%, var(--line));

    border-radius: 12px;

    background:
      color-mix(
        in srgb,
        var(--surface) 88%,
        transparent
      );

    box-shadow:
      0 25px 50px
      rgba(34, 73, 130, .08);

    backdrop-filter: blur(15px);

    transition:
      transform .25s ease,
      box-shadow .25s ease;
  }


  .hero-art:hover .visual-card {
    box-shadow:
      0 30px 60px
      rgba(34, 73, 130, .13);
  }


  .visual-label {
    position: absolute;

    top: 13px;
    left: 14px;

    color: var(--muted);

    font-size: 8px;

    font-weight: 800;

    letter-spacing: .14em;
  }


  .visual-left {
    width: 175px;
    height: 145px;

    left: 25px;
    top: 130px;

    display: grid;
    place-items: center;

    transform: rotateY(8deg);
  }


  .visual-left small {
    position: absolute;

    bottom: 12px;

    color: var(--muted);

    font-size: 8px;
  }


  .visual-center {
    width: 255px;
    height: 185px;

    left: 180px;
    top: 65px;

    z-index: 2;

    padding: 60px 27px 20px;
  }


  .visual-right {
    width: 145px;
    height: 125px;

    right: 4px;
    top: 145px;

    display: grid;
    place-items: center;

    transform: rotateY(-7deg);
  }


  .donut {
    width: 68px;
    height: 68px;

    border-radius: 50%;

    background:
      conic-gradient(
        var(--blue) 0 35%,
        var(--blue-soft) 35% 100%
      );

    position: relative;
  }


  .donut::after {
    content: "";

    position: absolute;

    inset: 18px;

    border-radius: 50%;

    background: var(--surface);
  }


  .pipeline {
    height: 55px;

    display: grid;
    grid-template-columns: repeat(4, 1fr);

    align-items: center;
  }


  .pipeline i {
    position: relative;

    width: 15px;
    height: 15px;

    justify-self: center;

    border-radius: 50%;

    background: var(--blue);
  }


  .pipeline i:not(:last-child)::after {
    content: "";

    position: absolute;

    width: 41px;

    height: 1px;

    left: 15px;
    top: 7px;

    background: var(--line);
  }


  .pipeline-labels {
    display: grid;
    grid-template-columns: repeat(4, 1fr);

    text-align: center;

    color: var(--muted);

    font-size: 8px;
  }


  .bars {
    height: 58px;

    display: flex;

    align-items: end;

    gap: 7px;
  }


  .bars i {
    width: 7px;

    display: block;

    border-radius: 2px 2px 0 0;

    background: var(--blue);
  }


  .bars i:nth-child(1) { height: 22%; }
  .bars i:nth-child(2) { height: 44%; }
  .bars i:nth-child(3) { height: 38%; }
  .bars i:nth-child(4) { height: 76%; }
  .bars i:nth-child(5) { height: 62%; }


  .floating-node {
    position: absolute;

    width: 5px;
    height: 5px;

    border-radius: 50%;

    background: var(--blue);
  }


  .node-1 {
    top: 35px;
    left: 25%;
  }


  .node-2 {
    top: 95px;
    right: 12%;
  }


  .node-3 {
    bottom: 35px;
    left: 45%;
  }


  .node-4 {
    top: 45%;
    left: 7%;
  }


  /* METRICS */

  .metrics {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    border: 1px solid var(--line);

    border-radius: 10px;

    overflow: hidden;

    background: var(--surface);

    box-shadow: var(--shadow);
  }


  .metrics article {
    min-height: 112px;

    padding: 22px 26px;

    border-right: 1px solid var(--line);
  }


  .metrics article:last-child {
    border-right: 0;
  }


  .metrics strong {
    display: block;

    color: var(--text);

    font-size: 27px;

    letter-spacing: -.04em;
  }


  .metrics h3 {
    margin: 6px 0 2px;

    font-size: 11px;
  }


  .metrics p {
    margin: 0;

    color: var(--muted);

    font-size: 9px;
  }


  /* GENERIC SECTIONS */

  .home-section {
    padding-top: 85px;
  }


  .section-heading {
    margin-bottom: 25px;

    display: flex;
    justify-content: space-between;
    align-items: end;
  }


  .section-heading h2 {
    margin: 7px 0 0;

    font-size: 30px;

    letter-spacing: -.035em;
  }


  .section-heading > a {
    color: var(--blue);

    font-size: 11px;
    font-weight: 750;
  }


  /* PROJECTS */

  .project-grid {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 14px;
  }


  .project-card {
    min-height: 310px;

    padding: 22px;

    display: flex;
    flex-direction: column;
    justify-content: space-between;

    border: 1px solid var(--line);

    border-radius: 10px;

    background: var(--surface);

    transition:
      transform .18s ease,
      box-shadow .18s ease,
      border-color .18s ease;
  }


  .project-card:hover {
    transform: translateY(-4px);

    border-color:
      color-mix(in srgb, var(--blue) 35%, var(--line));

    box-shadow: var(--shadow);
  }


  .project-top {
    display: flex;
    justify-content: space-between;
  }


  .project-number {
    color: var(--blue);

    font-size: 10px;
    font-weight: 800;
  }


  .project-arrow {
    color: var(--blue);

    font-size: 19px;

    transition: transform .18s ease;
  }


  .project-card:hover .project-arrow {
    transform:
      translate(2px, -2px);
  }


  .project-card h3 {
    margin: 55px 0 10px;

    font-size: 18px;

    letter-spacing: -.025em;
  }


  .project-card p {
    min-height: 70px;

    margin: 0;

    color: var(--muted);

    font-size: 11px;

    line-height: 1.7;
  }


  .impact {
    display: block;

    margin: 20px 0 14px;

    color: var(--blue);

    font-size: 11px;
  }


  /* SPLIT */

  .split-section {
    padding-top: 85px;

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 15px;
  }


  .feature-panel {
    min-height: 390px;

    padding: 28px;

    display: flex;
    flex-direction: column;

    border: 1px solid var(--line);

    border-radius: 10px;

    background: var(--surface);

    transition:
      transform .18s ease,
      box-shadow .18s ease;
  }


  .feature-panel:hover {
    transform: translateY(-3px);

    box-shadow: var(--shadow);
  }


  .feature-top {
    display: flex;
    justify-content: space-between;
  }


  .feature-arrow {
    color: var(--blue);

    font-size: 20px;
  }


  .feature-panel > h2 {
    max-width: 430px;

    margin: 48px 0 38px;

    font-family: Georgia, serif;

    font-size: 31px;

    line-height: 1.15;

    font-weight: 500;

    letter-spacing: -.035em;
  }


  .experience-item {
    display: grid;

    grid-template-columns: 30px 1fr;

    gap: 14px;
  }


  .dot {
    width: 10px;
    height: 10px;

    margin-top: 4px;

    border-radius: 50%;

    background: var(--blue);

    box-shadow:
      0 0 0 6px var(--blue-soft);
  }


  .experience-item strong {
    font-size: 12px;
  }


  .experience-item h3 {
    margin: 3px 0 7px;

    color: var(--muted);

    font-size: 11px;
  }


  .experience-item p {
    max-width: 410px;

    margin: 0;

    color: var(--muted);

    font-size: 10px;
  }


  .skill-cloud {
    display: flex;

    flex-wrap: wrap;

    gap: 8px;
  }


  .skill-cloud span {
    padding: 7px 11px;

    border: 1px solid var(--line);

    border-radius: 6px;

    background: var(--surface-soft);

    font-size: 10px;
  }


  .learn-more {
    margin-top: auto;

    color: var(--blue);

    font-size: 11px;

    font-weight: 750;
  }


  /* HOMELAB */

  .homelab-card {
    min-height: 410px;

    padding: 42px;

    display: grid;

    grid-template-columns: .8fr 1.2fr;

    gap: 65px;

    align-items: center;

    border: 1px solid var(--line);

    border-radius: 12px;

    background: var(--surface-soft);

    transition:
      transform .18s ease,
      box-shadow .18s ease;
  }


  .homelab-card:hover {
    transform: translateY(-3px);

    box-shadow: var(--shadow);
  }


  .homelab-copy h2 {
    margin: 12px 0 18px;

    font-family: Georgia, serif;

    font-size: 39px;

    line-height: 1.1;

    font-weight: 500;

    letter-spacing: -.04em;
  }


  .homelab-copy h2 span {
    display: block;

    color: var(--muted);
  }


  .homelab-copy p {
    color: var(--muted);

    font-size: 13px;

    line-height: 1.75;
  }


  .homelab-copy .learn-more {
    display: block;

    margin-top: 28px;
  }


  .lab-diagram {
    padding: 26px;

    border: 1px solid var(--line);

    border-radius: 10px;

    background: var(--surface);
  }


  .service-grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 8px;
  }


  .service {
    min-height: 59px;

    padding: 12px;

    display: flex;

    align-items: center;

    gap: 8px;

    border: 1px solid var(--line);

    border-radius: 6px;

    font-size: 9px;
  }


  .status-dot {
    width: 6px;
    height: 6px;

    flex: 0 0 auto;

    border-radius: 50%;

    background: var(--success);
  }


  .connector {
    width: 1px;
    height: 20px;

    margin-inline: auto;

    border-left: 1px dashed var(--blue);
  }


  .docker-node {
    width: max-content;

    margin-inline: auto;

    padding: 8px 28px;

    border: 1px solid var(--blue);

    border-radius: 6px;

    color: var(--blue);

    font-size: 10px;

    font-weight: 750;
  }


  .server-node {
    width: max-content;

    margin-inline: auto;

    padding: 10px 30px;

    text-align: center;

    border: 1px solid var(--line);

    border-radius: 6px;
  }


  .server-node strong,
  .server-node small {
    display: block;
  }


  .server-node strong {
    font-size: 10px;
  }


  .server-node small {
    margin-top: 2px;

    color: var(--muted);

    font-size: 8px;
  }


  /* ABOUT */

  .about-strip {
    margin-top: 85px;

    padding: 55px 0;

    display: grid;

    grid-template-columns: .8fr 1fr auto;

    gap: 60px;

    align-items: center;

    border-top: 1px solid var(--line);

    border-bottom: 1px solid var(--line);
  }


  .about-strip h2 {
    max-width: 390px;

    margin: 8px 0 0;

    font-family: Georgia, serif;

    font-size: 29px;

    line-height: 1.2;

    font-weight: 500;
  }


  .about-strip p {
    margin: 0;

    color: var(--muted);

    font-size: 12px;

    line-height: 1.75;
  }


  .about-strip > a {
    color: var(--blue);

    font-size: 11px;

    font-weight: 750;

    white-space: nowrap;
  }


  /* CTA */

  .contact-cta {
    margin-top: 55px;
    margin-bottom: 70px;

    padding: 31px;

    display: flex;

    justify-content: space-between;
    align-items: center;

    gap: 30px;

    border: 1px solid
      color-mix(in srgb, var(--blue) 30%, var(--line));

    border-radius: 10px;

    background:
      linear-gradient(
        90deg,
        var(--blue-soft),
        var(--surface)
      );
  }


  .contact-cta h2 {
    margin: 7px 0 5px;

    font-size: 21px;

    letter-spacing: -.025em;
  }


  .contact-cta p {
    margin: 0;

    color: var(--muted);

    font-size: 10px;
  }


  /* RESPONSIVE */

  @media (max-width: 1000px) {
    .project-grid {
      grid-template-columns: 1fr 1fr;
    }


    .hero {
      grid-template-columns: 1fr 1fr;
    }


    .homelab-card {
      grid-template-columns: 1fr;
    }
  }


  @media (max-width: 760px) {
    .hero {
      padding-top: 70px;

      grid-template-columns: 1fr;
    }


    .hero h1 {
      font-size: 72px;
    }


    .hero-art {
      min-height: 290px;

      transform: scale(.86);

      transform-origin: center;
    }


    .metrics {
      grid-template-columns: 1fr 1fr;
    }


    .metrics article:nth-child(2) {
      border-right: 0;
    }


    .metrics article:nth-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }


    .project-grid,
    .split-section {
      grid-template-columns: 1fr;
    }


    .about-strip {
      grid-template-columns: 1fr;

      gap: 24px;
    }


    .contact-cta {
      align-items: flex-start;

      flex-direction: column;
    }
  }


  @media (max-width: 520px) {
    .hero,
    .metrics,
    .home-section,
    .split-section,
    .about-strip,
    .contact-cta {
      width: calc(100% - 30px);
    }


    .hero-actions {
      align-items: stretch;

      flex-direction: column;
    }


    .metrics {
      grid-template-columns: 1fr;
    }


    .metrics article {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }


    .metrics article:last-child {
      border-bottom: 0;
    }


    .project-grid {
      grid-template-columns: 1fr;
    }


    .homelab-card {
      padding: 25px;
    }


    .service-grid {
