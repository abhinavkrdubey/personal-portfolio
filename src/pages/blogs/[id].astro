---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const blogs = await getCollection("blogs", ({ data }) => !data.draft);
  return blogs.map((blog) => ({ params: { id: blog.id }, props: { blog } }));
}

const { blog } = Astro.props;
const { Content } = await render(blog);
const site = (await getEntry("pages", "site"))!.data;
const projects = await getCollection("projects");
const relatedProjects = projects.filter((project) =>
  blog.data.projects.includes(project.id) || project.data.relatedBlogs.includes(blog.id)
);
const isoDate = blog.data.published.toISOString().slice(0, 10);
const displayDate = blog.data.published.toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric" });
---

<BaseLayout title={`${blog.data.title} — ${site.shortName}`} description={blog.data.description}>
  <article class="article">
    <a class="back-link" href="/blogs/">← Blogs</a>
    <header>
      <div class="meta"><time datetime={isoDate}>{displayDate}</time><span>{blog.data.tags.join(" · ")}</span></div>
      <h1>{blog.data.title}</h1>
      <p class="intro">{blog.data.description}</p>
    </header>

    <div class="article-body"><Content /></div>

    {relatedProjects.length > 0 && (
      <aside class="related">
        <span>RELATED PROJECTS</span>
        {relatedProjects.map((project) => <a href={`/projects/${project.id}/`}>{project.data.title} →</a>)}
      </aside>
    )}
  </article>
</BaseLayout>

<style>
  .article { width: min(900px, calc(100% - 48px)); margin: 0 auto; padding: 70px 0 100px; }
  .back-link { color: var(--muted); font-size: 14px; }
  .article header { padding: 64px 0 54px; border-bottom: 1px solid var(--line); }
  .meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; color: var(--blue); font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  h1 { max-width: 850px; margin: 20px 0; font-family: Georgia, serif; font-size: clamp(46px, 7vw, 76px); line-height: 1.04; letter-spacing: -.045em; font-weight: 500; }
  .intro { max-width: 700px; color: var(--muted); font-size: 18px; line-height: 1.7; }
  .article-body { max-width: 720px; margin: 0 auto; padding: 30px 0; }
  .article-body :global(h2) { margin: 52px 0 14px; font-family: Georgia, serif; font-size: 34px; font-weight: 500; }
  .article-body :global(p), .article-body :global(li) { color: var(--muted); font-size: 16px; line-height: 1.85; }
  .article-body :global(ul), .article-body :global(ol) { padding-left: 24px; }
  .article-body :global(a) { color: var(--blue); text-decoration: underline; }
  .article-body :global(img) { max-width: 100%; height: auto; border-radius: 12px; }
  .related { display: grid; gap: 12px; margin-top: 42px; padding: 28px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  .related > span { color: var(--muted); font-size: 12px; font-weight: 800; letter-spacing: .12em; }
  .related a { color: var(--blue); font-size: 18px; font-weight: 700; }
  @media (max-width: 720px) { .article { width: min(100% - 32px, 900px); padding-top: 40px; } .article header { padding: 44px 0; } }
</style>
