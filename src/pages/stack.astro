---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";
const site = (await getEntry("pages", "site"))!.data;
const page = (await getEntry("pages", "stack"))!.data;
const groups = page.groups;
const workflow = page.workflow;
---

<BaseLayout
  title={`Technical Stack — ${site.shortName}`}
  description="Technologies, methodologies and engineering tools I use to build machine learning and AI systems."
>
  <section class="page-hero">
    <span class="eyebrow">{page.eyebrow}</span>

    <h1>
      {page.headline}
    </h1>

    <p>
      {page.intro}
    </p>
  </section>

  <section class="stack-grid">
    {
      groups.map((group, index) => (
        <article class="stack-card">
          <div class="stack-number">
            {String(index + 1).padStart(2, "0")}
          </div>

          <h2>{group.title}</h2>
          <p>{group.description}</p>

          <div class="chips">
            {group.items.map((item) => <span>{item}</span>)}
          </div>
        </article>
      ))
    }
  </section>

  <section class="workflow">
    <div class="section-header">
      <span class="eyebrow">{page.workflowLabel}</span>
      <h2>{page.workflowTitle}</h2>
    </div>

    <div class="workflow-list">
      {
        workflow.map((item, index) => (
          <article>
            <span class="workflow-number">{String(index + 1).padStart(2, "0")}</span>

            <div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>

            <span class="arrow">→</span>
          </article>
        ))
      }
    </div>
  </section>

  <section class="bottom-cta">
    <div>
      <span class="eyebrow">{page.ctaLabel}</span>
      <h2>{page.ctaTitle}</h2>
    </div>

    <a href="/projects/">Explore projects →</a>
  </section>
</BaseLayout>

<style>
  .page-hero,
  .stack-grid,
  .workflow,
  .bottom-cta {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
  }

  .page-hero {
    padding: 90px 0 64px;
    max-width: 1180px;
  }

  .eyebrow {
    display: block;
    color: var(--blue);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .16em;
  }

  .page-hero h1 {
    max-width: 850px;
    margin: 14px 0 20px;
    font-family: Georgia, serif;
    font-size: clamp(48px, 6vw, 78px);
    line-height: 1.03;
    letter-spacing: -.045em;
    font-weight: 500;
  }

  .page-hero h1 span {
    color: var(--muted);
  }

  .page-hero p {
    max-width: 660px;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.75;
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .stack-card {
    position: relative;
    min-height: 280px;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    transition: .2s ease;
  }

  .stack-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .stack-card:last-child {
    grid-column: 1 / -1;
  }

  .stack-number {
    color: var(--blue);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .12em;
  }

  .stack-card h2 {
    margin: 35px 0 8px;
    font-size: 24px;
    letter-spacing: -.03em;
  }

  .stack-card p {
    max-width: 520px;
    margin: 0;
    color: var(--muted);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .chips span {
    padding: 7px 11px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface-soft);
    font-size: 11px;
    font-weight: 600;
  }

  .workflow {
    padding: 100px 0;
  }

  .section-header h2 {
    margin: 10px 0 32px;
    font-size: 34px;
    letter-spacing: -.035em;
  }

  .workflow-list {
    border-top: 1px solid var(--line);
  }

  .workflow-list article {
    display: grid;
    grid-template-columns: 60px 1fr auto;
    gap: 22px;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }

  .workflow-number {
    color: var(--blue);
    font-size: 11px;
    font-weight: 800;
  }

  .workflow-list h3 {
    margin: 0 0 4px;
    font-size: 16px;
  }

  .workflow-list p {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
  }

  .arrow {
    color: var(--muted);
    font-size: 20px;
  }

  .bottom-cta {
    margin-bottom: 70px;
    padding: 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface-soft);
  }

  .bottom-cta h2 {
    margin: 7px 0 0;
    font-size: 20px;
  }

  .bottom-cta a {
    color: var(--blue);
    font-weight: 750;
  }

  @media (max-width: 760px) {
    .stack-grid {
      grid-template-columns: 1fr;
    }

    .stack-card:last-child {
      grid-column: auto;
    }

    .workflow-list article {
      grid-template-columns: 40px 1fr;
    }

    .arrow {
      display: none;
    }

    .bottom-cta {
      align-items: flex-start;
      flex-direction: column;
      gap: 20px;
    }
  }
</style>
