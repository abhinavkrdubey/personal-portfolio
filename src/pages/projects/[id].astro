---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const site = (await getEntry("pages", "site"))!.data;
const blogs = await getCollection("blogs", ({ data }) => !data.draft);
const relatedBlogs = blogs.filter((blog) =>
  project.data.relatedBlogs.includes(blog.id) || blog.data.projects.includes(project.id)
);
---

<BaseLayout title={`${project.data.title} — ${site.shortName}`} description={project.data.description}>
  <article class="case-study">
    <a class="back-link" href="/projects/">← Projects</a>

    <header class="case-hero">
      <span class="eyebrow">{project.data.category.toUpperCase()}</span>
      <h1>{project.data.title}</h1>
      <p class="case-intro">{project.data.description}</p>

      {project.data.metrics.length > 0 && (
        <div class="case-metrics">
          {project.data.metrics.map((metric) => (
            <div><strong>{metric.value}</strong><span>{metric.label}</span></div>
          ))}
        </div>
      )}
    </header>

    <div class="project-body">
      <Content />
    </div>

    {relatedBlogs.length > 0 && (
      <aside class="related">
        <span>RELATED WRITING</span>
        {relatedBlogs.map((blog) => <a href={`/blogs/${blog.id}/`}>{blog.data.title} →</a>)}
      </aside>
    )}
  </article>
</BaseLayout>

<style>
  .case-study { width: min(960px, calc(100% - 48px)); margin: 0 auto; padding: 70px 0 100px; }
  .back-link { color: var(--muted); font-size: 13px; }
  .back-link:hover { color: var(--blue); }
  .case-hero { padding: 70px 0; border-bottom: 1px solid var(--line); }
  .eyebrow { color: var(--blue); font-size: 11px; font-weight: 800; letter-spacing: .16em; }
  h1 { margin: 14px 0 20px; font-family: Georgia, serif; font-size: clamp(54px, 8vw, 92px); line-height: 1; letter-spacing: -.05em; font-weight: 500; }
  .case-intro { max-width: 680px; color: var(--muted); font-size: 19px; line-height: 1.7; }
  .case-metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 52px; }
  .case-metrics div { padding: 22px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); }
  .case-metrics strong, .case-metrics span { display: block; }
  .case-metrics strong { font-family: Georgia, serif; font-size: 30px; }
  .case-metrics span { margin-top: 7px; color: var(--muted); font-size: 12px; }
  .project-body { max-width: 760px; margin: 0 auto; padding-top: 28px; }
  .project-body :global(h2) { margin: 56px 0 14px; font-family: Georgia, serif; font-size: 34px; font-weight: 500; }
  .project-body :global(p), .project-body :global(li) { color: var(--muted); font-size: 16px; line-height: 1.85; }
  .project-body :global(ul), .project-body :global(ol) { padding-left: 24px; }
  .project-body :global(a) { color: var(--blue); text-decoration: underline; }
  .project-body :global(img) { max-width: 100%; height: auto; border-radius: 12px; }
  .related { display: grid; gap: 12px; max-width: 760px; margin: 42px auto 0; padding: 28px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  .related > span { color: var(--muted); font-size: 12px; font-weight: 800; letter-spacing: .12em; }
  .related a { color: var(--blue); font-size: 18px; font-weight: 700; }
  @media (max-width: 720px) {
    .case-study { width: min(100% - 32px, 960px); padding-top: 38px; }
    .case-hero { padding: 48px 0; }
    .case-metrics { grid-template-columns: 1fr; }
  }
</style>
