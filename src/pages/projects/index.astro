---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";

const projects = (await getCollection("projects"))
  .sort((a, b) => a.data.order - b.data.order);
const site = (await getEntry("pages", "site"))!.data;
const page = (await getEntry("pages", "projects"))!.data;
---

<BaseLayout
  title={`Projects — ${site.shortName}`}
  description="Selected machine learning, AI and data science projects."
>
  <section class="page-header">
    <span class="eyebrow">{page.eyebrow}</span>

    <h1>{page.title}</h1>

    <p>
      {page.intro}
    </p>
  </section>

  <section class="projects-page-grid">
    {
      projects.map((project) => (
        <a
          class="project-large"
          href={`/projects/${project.id}/`}
        >
          <div class="project-number">
            {String(projects.indexOf(project) + 1).padStart(2, "0")}
          </div>

          <div>
            <h2>{project.data.title}</h2>

            <p>{project.data.description}</p>

            <strong>{project.data.impact}</strong>

            <div class="tags">
              {project.data.tags.map((tag) => <span>{tag}</span>)}
            </div>
          </div>

          <span class="project-arrow">↗</span>
        </a>
      ))
    }
  </section>
</BaseLayout>
