---
import { getEntry } from "astro:content";

const currentPath = Astro.url.pathname;
const site = (await getEntry("pages", "site"))!.data;
const links = site.nav;

function isActive(href) {
  if (href === "/") {
    return currentPath === "/";
  }

  return currentPath.startsWith(href);
}
---

<header class="navbar">

  <!-- BRAND -->
  <a
    class="brand"
    href="/"
    aria-label={`${site.name} homepage`}
  >
    {site.name}
  </a>


  <!-- NAVIGATION -->
  <nav aria-label="Main navigation">

    {
      links.map((link) => (
        <a
          href={link.href}
          class={isActive(link.href) ? "active" : ""}
        >
          {link.name}
        </a>
      ))
    }

  </nav>


  <!-- RIGHT ACTIONS -->
  <div class="nav-actions">

    <a
      class="resume-link"
      href={site.resume}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Open résumé in a new tab"
    >
      Resume
      <span>↗</span>
    </a>

    <button
      id="theme-toggle"
      type="button"
      aria-label="Toggle light and dark theme"
      title="Toggle theme"
    >
      ◐
    </button>

  </div>

</header>
